{
  "manifest_version": 3,
  "name": "AdSpy Pro — Ad Collector",
  "version": "1.0.0",
  "description": "Anonymously spot sponsored ads on Facebook and TikTok and contribute them to the AdSpy Pro ad database.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "*://*.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://wandering-avocet-151.convex.site/*"]
}
