{%- liquid
  assign product_faq = nil
  if section.settings.product_questions and product
    assign product_faq = product.metafields.adspy.page.value.faq
  endif
-%}
{%- if section.blocks.size > 0 or product_faq.size > 0 -%}
<section class="section scheme-{{ section.settings.scheme }}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="section__head"><h2 class="h2">{{ section.settings.heading | escape }}</h2></div>
    {%- elsif product_faq.size > 0 -%}
      <div class="section__head"><h2 class="h2">{{ 'products.faq' | t }}</h2></div>
    {%- endif -%}
    <div class="accordion">
      {%- comment -%} On a product page: the product's questions AdSpy Pro Launch wrote, then the blocks. {%- endcomment -%}
      {%- if product_faq.size > 0 -%}
        {%- for f in product_faq -%}
          <details class="accordion__item">
            <summary>{{ f.q | escape }} {% render 'icon', name: 'plus' %}</summary>
            <div class="accordion__body"><p>{{ f.a | escape }}</p></div>
          </details>
        {%- endfor -%}
      {%- endif -%}
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }} {% render 'icon', name: 'plus' %}</summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions & answers" },
    { "type": "checkbox", "id": "product_questions", "label": "On product pages, start with the product's questions (written by AdSpy Pro Launch)", "default": false },
    { "type": "select", "id": "scheme", "label": "Background", "default": "base", "options": [{ "value": "base", "label": "Page" }, { "value": "surface", "label": "Soft" }, { "value": "accent", "label": "Accent" }, { "value": "inverse", "label": "Inverted" }] }
  ],
  "blocks": [{ "type": "question", "name": "Question", "settings": [{ "type": "text", "id": "question", "label": "Question", "default": "Question" }, { "type": "richtext", "id": "answer", "label": "Answer" }] }],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
