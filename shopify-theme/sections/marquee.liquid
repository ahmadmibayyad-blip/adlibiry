{%- if section.blocks.size > 0 -%}
  <div class="marquee scheme-{{ section.settings.scheme }}" style="--marquee-speed: {{ section.settings.speed }}s">
    <div class="marquee__track">
      {%- for pass in (1..2) -%}
        <ul class="marquee__list" role="list" {% if pass == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="marquee__item" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling text",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per loop", "min": 10, "max": 60, "step": 2, "default": 30 },
    { "type": "select", "id": "scheme", "label": "Background", "default": "accent", "options": [{ "value": "base", "label": "Page" }, { "value": "surface", "label": "Soft" }, { "value": "accent", "label": "Accent" }, { "value": "inverse", "label": "Inverted" }] }
  ],
  "blocks": [{ "type": "item", "name": "Text", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Your message" }] }],
  "presets": [{ "name": "Scrolling text", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
