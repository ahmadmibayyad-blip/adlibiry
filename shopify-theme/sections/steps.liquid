<section class="section scheme-{{ section.settings.scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__head"><h2 class="h2">{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <ol class="grid grid--{{ section.blocks.size | at_most: 4 }} steps" role="list">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <span class="step__num">{{ forloop.index }}</span>
          <h3 class="h4">{{ block.settings.title | escape }}</h3>
          <p class="muted">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "surface", "options": [{ "value": "base", "label": "Page" }, { "value": "surface", "label": "Soft" }, { "value": "accent", "label": "Accent" }, { "value": "inverse", "label": "Inverted" }] }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "Step" }, { "type": "textarea", "id": "text", "label": "Text" }] }],
  "presets": [{ "name": "How it works", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
