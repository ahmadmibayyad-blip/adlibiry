<section class="password">
  <div class="page-width page-width--narrow center stack">
    <p class="logo__text">{{ settings.brand_name | default: shop.name | escape }}</p>
    <h1 class="h1">{{ 'password.opening_soon' | t }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'news-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="note note--ok">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="news-form__row">
          <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" aria-label="{{ 'newsletter.email' | t }}">
          <button type="submit" class="btn">{{ 'password.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="small">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="news-form__row">
          <input type="password" name="password" class="input" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
          <button type="submit" class="btn btn--outline">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
