{%- assign product = section.settings.product -%}
<section class="section scheme-{{ section.settings.scheme }}" id="Featured-{{ section.id }}">
  <div class="page-width">
    {%- if product != blank -%}
      {%- comment -%}
        Gallery and buy box. The buy box is built from blocks (snippets/product-block.liquid) the owner can add,
        move and remove in the theme editor, review apps' blocks included. A section saved without blocks gets
        the default list.
      {%- endcomment -%}
      {%- liquid
        assign current = product.selected_or_first_available_variant
        assign form_id = 'ProductForm-' | append: section.id
        assign page_data = product.metafields.adspy.page.value
      -%}
      <div class="product" data-product data-section="{{ section.id }}">
        {% render 'product-gallery', product: product %}
        <div class="product__info">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div class="product__app" {{ block.shopify_attributes }}>{% render block %}</div>
            {%- else -%}
              {% render 'product-block', block: block, type: block.type, product: product, section: section, current: current, form_id: form_id, page_data: page_data, heading_tag: 'h2' %}
            {%- endif -%}
          {%- else -%}
            {%- assign default_blocks = 'rating,title,subtitle,price,benefits,variant_picker,buy_buttons,trust_icons,delivery,payment_icons,description' | split: ',' -%}
            {%- for type in default_blocks -%}
              {% render 'product-block', block: nil, type: type, product: product, section: section, current: current, form_id: form_id, page_data: page_data, heading_tag: 'h2', defaults: true %}
            {%- endfor -%}
          {%- endfor -%}
        </div>
        <script type="application/json" data-variants>
          {{ product.variants | json }}
        </script>
      </div>
    {%- else -%}
      <p class="muted center">{{ 'products.choose_product' | t }}</p>
    {%- endif -%}
  </div>
</section>

