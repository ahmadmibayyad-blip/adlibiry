<div class="drawer" id="CartDrawer" data-cart-drawer hidden>
  <div class="drawer__overlay" data-drawer-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}" tabindex="-1">
    <header class="drawer__head">
      <h2 class="h4">{{ 'cart.title' | t }} <span class="muted">({{ cart.item_count }})</span></h2>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </header>
    {%- if cart.item_count > 0 -%}
      {%- liquid
        assign threshold = settings.free_shipping_threshold | times: 100
        assign remaining = threshold | minus: cart.total_price
        assign remaining_money = remaining | money
      -%}
      {%- if settings.free_shipping_threshold > 0 -%}
        <div class="ship-meter">
          {%- if remaining > 0 -%}
            <p>{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}</p>
          {%- else -%}
            <p>{% render 'icon', name: 'truck' %} {{ 'cart.free_shipping_unlocked' | t }}</p>
          {%- endif -%}
          {%- assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 -%}
          <div class="ship-meter__bar"><span style="width: {{ pct }}%"></span></div>
        </div>
      {%- endif -%}
      <div class="drawer__body">{% render 'cart-items' %}</div>
      <footer class="drawer__foot">
        <div class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
        <p class="small muted">{{ 'cart.taxes_shipping' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--block">{% render 'icon', name: 'lock' %} {{ 'cart.checkout' | t }}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="link-center small">{{ 'cart.view_cart' | t }}</a>
      </footer>
    {%- else -%}
      <div class="drawer__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </aside>
</div>

{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
