<article class="section section--tight">
  <div class="page-width page-width--narrow">
    <p class="small muted">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h1">{{ article.title | escape }}</h1>
    {%- if article.image -%}<div class="article__image">{{ article.image | image_url: width: 1400 | image_tag: alt: article.title }}</div>{%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p><a href="{{ blog.url }}" class="link-arrow">&larr; {{ blog.title | escape }}</a></p>
  </div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
