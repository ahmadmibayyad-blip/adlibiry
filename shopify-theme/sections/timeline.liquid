<section class="section scheme-{{ section.settings.scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__head">
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ol class="timeline" role="list" style="--stages: {{ section.blocks.size | at_least: 1 }}">
      {%- for block in section.blocks -%}
        <li class="timeline__stage" {{ block.shopify_attributes }}>
          <span class="timeline__dot" aria-hidden="true"></span>
          {%- if block.settings.label != blank -%}<p class="timeline__label">{{ block.settings.label | escape }}</p>{%- endif -%}
          <h3 class="h4">{{ block.settings.title | escape }}</h3>
          <p class="muted">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- liquid
      assign product = all_products[section.settings.product]
      assign link = section.settings.button_link
      if link == blank and product
        assign link = product.url
      endif
    -%}
    {%- if section.settings.button_label != blank and link != blank -%}
      <div class="timeline__cta"><a class="btn" href="{{ link }}">{{ section.settings.button_label | escape }}</a></div>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<p class="timeline__note muted">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "What to expect",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What to expect" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "product", "id": "product", "label": "Product", "info": "The button goes to this product unless a link is set." },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small print", "default": "Everyone is different: results vary from person to person." },
    { "type": "select", "id": "scheme", "label": "Background", "default": "base", "options": [{ "value": "base", "label": "Page" }, { "value": "surface", "label": "Soft" }, { "value": "accent", "label": "Accent" }, { "value": "inverse", "label": "Inverted" }] }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        { "type": "text", "id": "label", "label": "When", "default": "Week 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "First use" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "What to expect", "blocks": [{ "type": "stage" }, { "type": "stage" }, { "type": "stage" }] }]
}
{% endschema %}
