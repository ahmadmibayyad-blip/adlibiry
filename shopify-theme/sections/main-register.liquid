<section class="section section--tight">
  <div class="page-width page-width--xs stack">
    <h1 class="h2">{{ 'customer.create' | t }}</h1>
    {%- form 'create_customer', class: 'stack' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span class="field__label">{{ 'customer.first_name' | t }}</span><input class="input" type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="field"><span class="field__label">{{ 'customer.last_name' | t }}</span><input class="input" type="text" name="customer[last_name]" autocomplete="family-name"></label>
      <label class="field"><span class="field__label">{{ 'contact.email' | t }}</span><input class="input" type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="field"><span class="field__label">{{ 'password.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--block">{{ 'customer.create' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
