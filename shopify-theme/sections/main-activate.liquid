<section class="section section--tight">
  <div class="page-width page-width--xs stack">
    <h1 class="h2">{{ 'customer.activate' | t }}</h1>
    {%- form 'activate_customer_password', class: 'stack' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span class="field__label">{{ 'password.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="field"><span class="field__label">{{ 'customer.confirm_password' | t }}</span><input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--block">{{ 'customer.activate' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
