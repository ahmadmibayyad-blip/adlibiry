{%- comment -%} {% render 'product-card', product: product %} {%- endcomment -%}
<article class="card">
  <a href="{{ product.url }}" class="card__media" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
    {%- if product.media[1] -%}
      {{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', class: 'card__alt', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
    {%- endif -%}
    {%- if product.compare_at_price > product.price -%}
      <span class="badge badge--sale card__badge">{{ 'products.sale' | t }}</span>
    {%- elsif product.available == false -%}
      <span class="badge card__badge">{{ 'products.sold_out' | t }}</span>
    {%- endif -%}
  </a>
  <div class="card__body">
    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    {% render 'price', product: product %}
  </div>
</article>
