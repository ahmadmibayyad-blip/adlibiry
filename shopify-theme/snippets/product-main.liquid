{%- comment -%}
  Gallery + buy box, shared by the product page and the home page's featured product.
  {% render 'product-main', product: product, section: section, heading_tag: 'h1' %}
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign page_data = product.metafields.adspy.page.value
-%}
<div class="product" data-product data-section="{{ section.id }}">
  <div class="product__gallery" data-gallery>
    <div class="gallery__main">
      {%- for media in product.media limit: 10 -%}
        <div class="gallery__slide{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}">
          {%- if media.media_type == 'image' -%}
            {%- if forloop.first -%}{%- assign loading = 'eager' -%}{%- else -%}{%- assign loading = 'lazy' -%}{%- endif -%}
            {{ media | image_url: width: 1400 | image_tag: loading: loading, widths: '500, 750, 1000, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt }}
          {%- else -%}
            {{ media | media_tag: image_size: '1400x' }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="gallery__thumbs" role="list">
        {%- for media in product.media limit: 10 -%}
          <button type="button" class="gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ 'products.view_image' | t: number: forloop.index }}">
            {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- if section.settings.show_vendor and product.vendor != blank -%}<p class="eyebrow">{{ product.vendor | escape }}</p>{%- endif -%}
    <{{ heading_tag | default: 'h1' }} class="h2 product__title">{{ product.title | escape }}</{{ heading_tag | default: 'h1' }}>
    {%- if page_data.subtitle != blank -%}<p class="lead muted">{{ page_data.subtitle | escape }}</p>{%- endif -%}
    <div data-price-wrap>{% render 'price', product: product, variant: current %}</div>

    {%- comment -%}
      Sale countdown: only with an end date the owner set (settings.sale_end_date, the end of that
      day in the store's time zone) and only while the chosen variant has a compare-at price.
    {%- endcomment -%}
    {%- if settings.sale_end_date != blank -%}
      <p class="sale-timer" data-sale-timer data-end="{{ settings.sale_end_date | strip }}T23:59:59{{ 'now' | date: '%z' | slice: 0, 3 }}:{{ 'now' | date: '%z' | slice: 3, 2 }}" hidden>
        {% render 'icon', name: 'clock' %}
        <span>{{ 'products.sale_ends_html' | t: time: '<strong data-sale-time></strong>' }}</span>
      </p>
    {%- endif -%}

    {%- if page_data.benefits.size > 0 -%}
      <ul class="ticks" role="list">
        {%- for b in page_data.benefits limit: 4 -%}<li>{% render 'icon', name: 'check' %} {{ b | escape }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}

    {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <label class="field">
            <span class="field__label">{{ option.name | escape }}</span>
            <select class="select" data-option-index="{{ forloop.index0 }}">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endfor -%}
      {%- endunless -%}
      {%- comment -%}
        Quantity deals: the owner turns them on and sets the % off for 2 and 3 items. The prices shown
        are only honest with a matching automatic discount in Shopify (Discounts → Amount off products,
        minimum quantity), which the setting's label asks for. Picking a deal sets the quantity.
      {%- endcomment -%}
      {%- if settings.bundle_enabled and settings.bundle_2_off > 0 -%}
        {%- liquid
          assign tiers = '1'
          assign tiers = tiers | append: ',2:' | append: settings.bundle_2_off
          if settings.bundle_3_off > 0
            assign tiers = tiers | append: ',3:' | append: settings.bundle_3_off
          endif
          assign tiers = tiers | split: ','
        -%}
        <fieldset class="deals" data-deals>
          <legend class="field__label">{{ 'products.deals_heading' | t }}</legend>
          {%- for tier in tiers -%}
            {%- liquid
              assign parts = tier | split: ':'
              assign qty = parts[0] | plus: 0
              assign off = parts[1] | default: 0 | plus: 0
              assign full = current.price | times: qty
              assign pay = 100 | minus: off | times: full | divided_by: 100
            -%}
            <label class="deal{% if forloop.first %} is-selected{% endif %}">
              <input type="radio" name="deal-{{ section.id }}" value="{{ qty }}" data-deal-qty="{{ qty }}" data-deal-off="{{ off }}"{% if forloop.first %} checked{% endif %}>
              <span class="deal__name">{{ 'products.deal_items' | t: count: qty }}</span>
              {%- if off > 0 -%}<span class="badge badge--sale">{{ 'products.deal_save' | t: percent: off }}</span>{%- endif -%}
              <span class="deal__price">
                <span data-deal-price>{{ pay | money }}</span>
                {%- if off > 0 -%}<s class="muted" data-deal-full>{{ full | money }}</s>{%- endif -%}
              </span>
            </label>
          {%- endfor -%}
        </fieldset>
      {%- endif -%}
      <div class="product-form__row">
        <div class="qty" data-qty>
          <button type="button" class="qty__btn" data-qty-change="-1" aria-label="{{ 'cart.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
          <input class="qty__input" type="number" name="quantity" min="1" value="1" aria-label="{{ 'cart.quantity' | t }}">
          <button type="button" class="qty__btn" data-qty-change="1" aria-label="{{ 'cart.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
        </div>
        <button type="submit" name="add" class="btn btn--large btn--grow" data-add-button{% unless current.available %} disabled{% endunless %}>
          {%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>
      </div>
      {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
      <p class="form-error" data-form-error hidden></p>
    {%- endform -%}

    {%- if settings.trust_line_1 != blank or settings.trust_line_2 != blank or settings.trust_line_3 != blank -%}
      <ul class="trust-lines" role="list">
        {%- if settings.trust_line_1 != blank -%}<li>{% render 'icon', name: 'truck' %} {{ settings.trust_line_1 | escape }}</li>{%- endif -%}
        {%- if settings.trust_line_2 != blank -%}<li>{% render 'icon', name: 'return' %} {{ settings.trust_line_2 | escape }}</li>{%- endif -%}
        {%- if settings.trust_line_3 != blank -%}<li>{% render 'icon', name: 'lock' %} {{ settings.trust_line_3 | escape }}</li>{%- endif -%}
      </ul>
    {%- endif -%}

    {%- if settings.delivery_max_days > 0 or settings.show_payment_icons -%}
      <div class="cart-extras product-extras">
        {%- if settings.delivery_max_days > 0 -%}
          <p class="cart-eta" data-eta data-min="{{ settings.delivery_min_days | default: settings.delivery_max_days }}" data-max="{{ settings.delivery_max_days }}" hidden>
            {% render 'icon', name: 'truck' %}
            <span>{{ 'cart.delivery_eta_html' | t: dates: '<strong data-eta-dates></strong>' }}</span>
          </p>
        {%- endif -%}
        {%- if settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="pay-icons" role="list" aria-label="{{ 'cart.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_description and product.description != blank -%}
      <details class="accordion__item" open>
        <summary>{{ 'products.description' | t }} {% render 'icon', name: 'plus' %}</summary>
        <div class="accordion__body rte">{{ product.description }}</div>
      </details>
    {%- endif -%}
  </div>

  <script type="application/json" data-variants>
    {{ product.variants | json }}
  </script>
</div>
