{%- comment -%}
  Reviews from buyers at the supplier (Launch: convex/lib/supplierReviews.ts), labelled as such,
  with the listing's real average and count. `reviews`: the product's adspy.reviews metafield value;
  `heading`: optional, replaces the default heading.
{%- endcomment -%}
<div class="section__head">
  <h2 class="h2">{%- if heading != blank -%}{{ heading | escape }}{%- else -%}{{ 'products.reviews_heading' | t }}{%- endif -%}</h2>
  <p class="reviews__summary">
    {% render 'stars', rating: reviews.average %}
    <strong>{{ reviews.average }}</strong>
    <span class="muted">
      {%- if reviews.listings > 1 -%}{{ 'products.reviews_source_many' | t: count: reviews.total }}{%- else -%}{{ 'products.reviews_source' | t: count: reviews.total }}{%- endif -%}
    </span>
  </p>
  {%- if reviews.stars.size == 5 and reviews.total > 0 -%}
    <ul class="reviews__bars" role="list">
      {%- for n in reviews.stars -%}
        {%- assign star = 6 | minus: forloop.index -%}
        {%- assign pct = n | times: 100 | divided_by: reviews.total -%}
        <li>
          <span class="reviews__bars-star">{{ star }} {% render 'icon', name: 'star' %}</span>
          <span class="reviews__bar" aria-hidden="true"><span style="width: {{ pct }}%"></span></span>
          <span class="reviews__bars-count">{{ n }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
<div class="reviews__grid">
  {%- for r in reviews.items -%}
    <figure class="review">
      {% render 'stars', rating: r.rating %}
      <blockquote class="review__text">{{ r.text | escape }}</blockquote>
      {%- if r.images.size > 0 -%}
        <div class="review__photos">
          {%- for img in r.images -%}<img src="{{ img | escape }}" alt="" loading="lazy" width="72" height="72">{%- endfor -%}
        </div>
      {%- endif -%}
      <figcaption class="review__by">
        {%- if r.name != blank -%}{{ r.name | escape }}{%- else -%}{{ 'products.reviews_buyer' | t }}{%- endif -%}
        {%- if r.country != blank %} · {{ r.country | escape }}{%- endif -%}
      </figcaption>
    </figure>
  {%- endfor -%}
</div>
