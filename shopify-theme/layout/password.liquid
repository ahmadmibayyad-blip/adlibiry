<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {% render 'theme-style' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
