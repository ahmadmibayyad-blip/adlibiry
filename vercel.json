{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "node scripts/setup-convex-env.mjs && npx convex deploy --cmd 'pnpm run build'",
  "outputDirectory": "dist",
  "functions": {
    "api/render.ts": { "maxDuration": 60, "includeFiles": "node_modules/.pnpm/@sparticuz+chromium@153.0.0/node_modules/@sparticuz/chromium/bin/**" }
  },
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/landing" },
    { "source": "/vs/:slug", "destination": "/vs/:slug.html" },
    { "source": "/((?!api/|vs/|assets/|actors/|videos/|chrome-extension/|icon/|istilam/|sw.js|site.webmanifest|offline.html|robots.txt|sitemap.xml|adspy-pro-extension.zip).*)", "destination": "/app.html" }
  ]
}
