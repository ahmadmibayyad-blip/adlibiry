{%- comment -%}
  AdSpy Pro: the owner's own customer reviews, typed in as blocks (stars, text, name, photo, "Verified
  purchase"), with their average. Hidden without any.
{%- endcomment -%}
{%- liquid
  assign total = 0
  assign count = 0
  for block in section.blocks
    if block.settings.text != blank
      assign total = total | plus: block.settings.rating
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- capture star -%}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>{%- endcapture -%}
{%- if count > 0 -%}
  {%- assign average = total | times: 1.0 | divided_by: count | round: 1 -%}
  <style>
    .adspy-testimonials { text-align: center; }
    .adspy-testimonials__summary { display: flex; align-items: center; justify-content: center; gap: .8rem; margin: .8rem 0 0; }
    .adspy-testimonials__stars { display: inline-flex; gap: .2rem; color: #f5a524; }
    .adspy-testimonials__stars svg { width: 1.6rem; height: 1.6rem; fill: currentColor; }
    .adspy-testimonials__stars .is-off { opacity: .25; }
    .adspy-testimonials__list { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(26rem, calc((100% - 4.8rem) / 4)); gap: 1.6rem; overflow-x: auto; scroll-snap-type: x mandatory; margin-top: 3rem; padding-bottom: .8rem; text-align: left; }
    @media screen and (max-width: 989px) { .adspy-testimonials__list { grid-auto-columns: minmax(24rem, 78%); } }
    .adspy-testimonial { margin: 0; display: flex; flex-direction: column; border: .1rem solid rgba(var(--color-foreground), .12); border-radius: var(--text-boxes-radius, .8rem); overflow: hidden; scroll-snap-align: start; background: rgb(var(--color-background)); }
    .adspy-testimonial img { width: 100%; aspect-ratio: 1; object-fit: cover; }
    .adspy-testimonial__body { display: grid; gap: .8rem; padding: 1.8rem; flex: 1; align-content: start; }
    .adspy-testimonial blockquote { margin: 0; font-size: 1.5rem; line-height: 1.55; }
    .adspy-testimonial figcaption { display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: 1.3rem; margin-top: auto; }
    .adspy-testimonial__verified { color: #15803d; font-weight: 600; }
  </style>
  <div class="color-{{ section.settings.color_scheme }} gradient adspy-js-reviews" id="adspy-reviews">
    <div class="adspy-testimonials page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
      <h2 class="h2">{%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- else -%}{{ 'adspy.reviews_heading' | t }}{%- endif -%}</h2>
      {%- assign filled = average | round -%}
      <p class="adspy-testimonials__summary">
        <span class="adspy-testimonials__stars" role="img" aria-label="{{ 'adspy.rating' | t: rating: average }}">
          {%- for i in (1..5) -%}<span{% if i > filled %} class="is-off"{% endif %}>{{ star }}</span>{%- endfor -%}
        </span>
        <strong>{{ average }}/5</strong>
        <span>{{ 'adspy.reviews_based_on' | t: count: count }}</span>
      </p>
      <div class="adspy-testimonials__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign r = block.settings -%}
          {%- if r.text == blank -%}{%- continue -%}{%- endif -%}
          {%- assign filled = r.rating -%}
          <figure class="adspy-testimonial" role="listitem" {{ block.shopify_attributes }}>
            {%- if r.image != blank -%}{{ r.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 640', alt: r.name }}{%- endif -%}
            <div class="adspy-testimonial__body">
              <span class="adspy-testimonials__stars" role="img" aria-label="{{ 'adspy.rating' | t: rating: r.rating }}">
                {%- for i in (1..5) -%}<span{% if i > filled %} class="is-off"{% endif %}>{{ star }}</span>{%- endfor -%}
              </span>
              {%- if r.title != blank -%}<strong>{{ r.title | escape }}</strong>{%- endif -%}
              <blockquote>{{ r.text | escape | newline_to_br }}</blockquote>
              <figcaption>
                <strong>{{ r.name | escape }}</strong>
                {%- if r.verified -%}<span class="adspy-testimonial__verified">✓ {{ 'adspy.verified' | t }}</span>{%- endif -%}
              </figcaption>
            </div>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 3rem 1.5rem; text-align: center;"><p>{{ 'adspy.reviews_empty_editor' | t }}</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "max_blocks": 24,
  "settings": [
    { "type": "paragraph", "content": "Your own customers' reviews. Only real reviews: copy them from emails, messages or your review app." },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name and city", "default": "Anna, Copenhagen" },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Customer reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
