{%- comment -%}
  AdSpy Pro: the product's questions and answers written by Launch (the adspy.page metafield).
  Shows nothing when the product has none.
{%- endcomment -%}
{%- assign page_data = product.metafields.adspy.page.value -%}
{%- if page_data.faq.size > 0 -%}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width page-width--narrow" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
      <h2 class="h2 center">{{ 'adspy.faq' | t }}</h2>
      {%- for f in page_data.faq -%}
        <div class="accordion">
          <details>
            <summary>
              <div class="summary__title"><h3 class="h4 accordion__title">{{ f.q | escape }}</h3></div>
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </summary>
            <div class="accordion__content rte"><p>{{ f.a | escape }}</p></div>
          </details>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product questions",
  "settings": [
    { "type": "paragraph", "content": "The product's questions and answers, written by AdSpy Pro Launch. Hidden when the product has none." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
